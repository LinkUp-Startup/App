# Copy to .env and adjust. EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
# Restart `npm start` after changing this file.

# Local backend (`dotnet run` in backend/, port 5000):
#   Android emulator  -> http://10.0.2.2:5000   (10.0.2.2 = your computer, seen from the emulator)
#   Phone on Wi-Fi    -> http://<your-LAN-IP>:5000
#   Phone over USB    -> http://localhost:5000  (after `adb reverse tcp:5000 tcp:5000`)
# Dev server (Dokploy, project_dev):
#   -> https://<dev-api-domain>
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
