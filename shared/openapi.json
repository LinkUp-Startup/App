        "type": "object",
        "properties": {
          "venue": {
            "$ref": "#/components/schemas/VenueDto"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "estimatedCostPerPerson": {
            "type": "number",
            "format": "double"
          },
          "distanceKm": {
            "type": "number",
            "format": "double"
          }
        }
