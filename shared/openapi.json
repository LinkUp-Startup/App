        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanItemDto"
            }
          },
          "estimatedCostPerPerson": {
            "type": "number",
            "format": "double"
          },
          "totalDistanceKm": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "PlanItemDto": {
        "required": [
          "venue",
          "startTime",
          "endTime",
          "estimatedCostPerPerson",
          "distanceKm"
