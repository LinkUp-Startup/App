            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "maxSpend": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "priceLevel": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "isActive": {
            "type": "boolean"
          },
          "openingHours": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpeningHoursDto"
